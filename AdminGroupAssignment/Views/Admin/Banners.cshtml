@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Banners";
    ViewData["Subtitle"] = "Create and manage promotional banners.";
}
@section Styles { <link rel="stylesheet" href="~/css/banners.css" asp-append-version="true" /> }

<div class="banners-page">
    <section class="banners-heading"><div><h2>Banner Management</h2><p>Manage promotional content displayed to members.</p></div><div class="banner-heading-actions"><button type="button" id="refreshBanners" class="banner-button secondary"><i class="bi bi-arrow-clockwise"></i><span>Refresh</span></button><button type="button" id="addBanner" class="banner-button primary"><i class="bi bi-plus-lg"></i> Add banner</button></div></section>
    <div id="bannerMessage" class="banner-message" role="alert" hidden></div>
    <section class="banner-summary"><article><span><i class="bi bi-images"></i></span><div><small>Total banners</small><strong id="bannerTotal">0</strong><p>All promotions</p></div></article><article><span><i class="bi bi-check-circle"></i></span><div><small>Active</small><strong id="bannerActive">0</strong><p>Currently visible</p></div></article><article><span><i class="bi bi-calendar-x"></i></span><div><small>Expired</small><strong id="bannerExpired">0</strong><p>Past the end date</p></div></article><article><span><i class="bi bi-link-45deg"></i></span><div><small>With links</small><strong id="bannerLinked">0</strong><p>Interactive promotions</p></div></article></section>
    <section class="banners-card"><header class="banners-toolbar"><div><h3>Banner Gallery</h3><p id="bannerResultText">Loading banners...</p></div><button type="button" id="exportBanners" class="banner-button secondary" disabled><i class="bi bi-download"></i> Export CSV</button></header><div class="banner-filters"><label class="banner-search"><i class="bi bi-search"></i><input id="bannerSearch" type="search" placeholder="Search title, subtitle or type" /></label><label><span>Status</span><select id="bannerStatus"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option><option value="Expired">Expired</option></select></label><label><span>Sort</span><select id="bannerSort"><option value="newest">Newest first</option><option value="expiry">Expiry soon</option><option value="title">Title A-Z</option></select></label></div><div id="bannerLoading" class="banner-state"><div class="spinner-border spinner-border-sm"></div><p>Loading banners...</p></div><div id="bannerEmpty" class="banner-state" hidden><i class="bi bi-images"></i><h4 id="bannerEmptyTitle">No banners yet</h4><p id="bannerEmptyText">Create the first banner.</p><button type="button" id="retryBanners" class="banner-button secondary" hidden>Try again</button></div><div id="bannerGrid" class="banner-grid" hidden></div></section>
</div>

<div class="modal fade" id="bannerFormModal" tabindex="-1" aria-labelledby="bannerFormTitle" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content banner-modal"><form id="bannerForm" novalidate><div class="modal-header"><div><p id="bannerFormEyebrow" class="banner-modal-eyebrow">New banner</p><h2 id="bannerFormTitle" class="modal-title">Create banner</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input id="bannerId" type="hidden" /><div class="banner-form-grid">
    <label><span>Title <b>*</b></span><input id="bannerTitle" required maxlength="180" placeholder="Promotion title" /></label><label><span>Subtitle</span><input id="bannerSubTitle" maxlength="220" placeholder="Supporting message" /></label><label><span>Type</span><input id="bannerType" maxlength="100" placeholder="e.g. Highlight, Promotion" /></label><label><span>Status <b>*</b></span><select id="bannerStatusInput" required><option value="Active">Active</option><option value="Inactive">Inactive</option></select></label><label><span>Expiry date <b>*</b></span><input id="bannerExpireDate" type="datetime-local" required /></label><label><span>Button text</span><input id="bannerButtonText" maxlength="60" placeholder="e.g. Learn more" /></label><label class="wide"><span>Image path or URL</span><input id="bannerImage" placeholder="https://example.com/banner.jpg" /></label><label class="wide"><span>External link</span><input id="bannerExternalLink" placeholder="https://example.com/promotion" /></label><label class="wide"><span>Description</span><textarea id="bannerDescription" rows="4" maxlength="1200"></textarea></label><label class="wide"><span>iOS description</span><textarea id="bannerDescriptionIos" rows="3" maxlength="1200" placeholder="Leave empty to use the main description."></textarea></label><label class="wide"><span>Terms and conditions</span><textarea id="bannerTnc" rows="4" maxlength="2000"></textarea></label>
</div></div><div class="modal-footer banner-form-footer"><div id="bannerFormError" class="banner-form-error" hidden></div><div class="banner-form-actions"><button type="button" class="banner-button secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" id="saveBanner" class="banner-button primary"><span class="spinner-border spinner-border-sm" hidden></span><span>Create banner</span></button></div></div></form></div></div></div>

<div class="modal fade" id="bannerDeleteModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content banner-modal banner-delete-modal"><div class="modal-body"><span class="banner-delete-icon"><i class="bi bi-trash3"></i></span><h2>Delete banner?</h2><p>This permanently removes <strong id="bannerDeleteName">this banner</strong>.</p><div id="bannerDeleteError" class="banner-form-error" hidden></div></div><div class="modal-footer"><button type="button" class="banner-button secondary" data-bs-dismiss="modal">Cancel</button><button type="button" id="confirmDeleteBanner" class="banner-button danger"><span class="spinner-border spinner-border-sm" hidden></span><span>Delete banner</span></button></div></div></div></div>
@section Scripts { <script src="~/js/banners.js" asp-append-version="true"></script> }
