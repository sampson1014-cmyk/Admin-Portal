@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Stamp Campaigns";
    ViewData["Subtitle"] = "Create and manage digital stamp campaigns.";
}

@section Styles { <link rel="stylesheet" href="~/css/stamp-campaigns.css" asp-append-version="true" /> }

<div class="stamps-page">
    <section class="stamps-heading"><div><h2>Stamp Campaigns</h2><p>Manage the stamp goals members complete to earn rewards.</p></div><div class="stamps-heading-actions"><button type="button" id="refreshStamps" class="stamp-button secondary"><i class="bi bi-arrow-clockwise"></i><span>Refresh</span></button><button type="button" id="addStamp" class="stamp-button primary"><i class="bi bi-plus-lg"></i> Add campaign</button></div></section>
    <div id="stampMessage" class="stamp-message" role="alert" hidden></div>
    <section class="stamp-summary" aria-label="Campaign summary">
        <article><span class="stamp-summary-icon total"><i class="bi bi-award"></i></span><div><small>Total campaigns</small><strong id="stampTotal">0</strong><p>All stamp campaigns</p></div></article>
        <article><span class="stamp-summary-icon active"><i class="bi bi-check-circle"></i></span><div><small>Active</small><strong id="stampActive">0</strong><p>Currently available</p></div></article>
        <article><span class="stamp-summary-icon expired"><i class="bi bi-calendar-x"></i></span><div><small>Expired</small><strong id="stampExpired">0</strong><p>Past the end date</p></div></article>
        <article><span class="stamp-summary-icon target"><i class="bi bi-bullseye"></i></span><div><small>Average target</small><strong id="stampAverage">0</strong><p>Stamps per campaign</p></div></article>
    </section>
    <section class="stamps-card">
        <header class="stamps-toolbar"><div><h3>Campaign List</h3><p id="stampResultText" aria-live="polite">Loading campaigns...</p></div><button type="button" id="exportStamps" class="stamp-button secondary" disabled><i class="bi bi-download"></i> Export CSV</button></header>
        <div class="stamp-filters"><label class="stamp-search" for="stampSearch"><i class="bi bi-search"></i><input id="stampSearch" type="search" placeholder="Search campaign name, ID or description" /></label><label><span>Status</span><select id="stampStatus"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option><option value="Expired">Expired</option></select></label><label><span>Sort</span><select id="stampSort"><option value="newest">Newest first</option><option value="expiry">Expiry soon</option><option value="target-asc">Lowest target</option><option value="target-desc">Highest target</option><option value="name">Name A-Z</option></select></label></div>
        <div id="stampLoading" class="stamp-state"><div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Loading</span></div><p>Loading stamp campaigns...</p></div>
        <div id="stampEmpty" class="stamp-state" hidden><i class="bi bi-award"></i><h4 id="stampEmptyTitle">No campaigns yet</h4><p id="stampEmptyText">Create the first stamp campaign.</p><button type="button" id="retryStamps" class="stamp-button secondary" hidden>Try again</button></div>
        <div id="stampTableWrapper" class="table-responsive" hidden><table class="stamp-table"><thead><tr><th>Campaign</th><th>Target</th><th>Created</th><th>Expires</th><th>Status</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody id="stampTableBody"></tbody></table></div>
    </section>
</div>

<div class="modal fade" id="stampFormModal" tabindex="-1" aria-labelledby="stampFormTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content stamp-modal"><form id="stampForm" novalidate>
    <div class="modal-header"><div><p id="stampFormEyebrow" class="stamp-modal-eyebrow">New campaign</p><h2 id="stampFormTitle" class="modal-title">Create stamp campaign</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body"><input id="stampId" type="hidden" /><div class="stamp-form-grid">
        <label><span>Campaign name <b>*</b></span><input id="stampName" required maxlength="120" placeholder="e.g. Coffee Collector" /></label>
        <label><span>Stamp target <b>*</b></span><input id="stampPoint" type="number" min="1" step="1" required placeholder="10" /></label>
        <label><span>Status <b>*</b></span><select id="stampStatusInput" required><option value="Active">Active</option><option value="Inactive">Inactive</option></select></label>
        <label><span>Image path or URL</span><input id="stampImage" placeholder="https://example.com/stamp.jpg" /></label>
        <label><span>Start date <b>*</b></span><input id="stampCreateDate" type="datetime-local" required /></label>
        <label><span>Expiry date <b>*</b></span><input id="stampExpireDate" type="datetime-local" required /></label>
        <label class="wide"><span>Description</span><textarea id="stampDescription" rows="5" maxlength="1000" placeholder="Explain how members collect stamps and what they can earn."></textarea></label>
    </div></div>
    <div class="modal-footer stamp-form-footer"><div id="stampFormError" class="stamp-form-error" role="alert" hidden></div><div class="stamp-form-actions"><button type="button" class="stamp-button secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" id="saveStamp" class="stamp-button primary"><i class="bi bi-plus-lg stamp-save-icon"></i><span class="spinner-border spinner-border-sm" hidden></span><span>Create campaign</span></button></div></div>
</form></div></div></div>

<div class="modal fade" id="stampDeleteModal" tabindex="-1" aria-labelledby="stampDeleteTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content stamp-modal stamp-delete-modal"><div class="modal-body"><span class="stamp-delete-icon"><i class="bi bi-trash3"></i></span><h2 id="stampDeleteTitle">Delete campaign?</h2><p>This permanently removes <strong id="stampDeleteName">this campaign</strong>.</p><div id="stampDeleteError" class="stamp-form-error" role="alert" hidden></div></div><div class="modal-footer"><button type="button" class="stamp-button secondary" data-bs-dismiss="modal">Cancel</button><button type="button" id="confirmDeleteStamp" class="stamp-button danger"><span class="spinner-border spinner-border-sm" hidden></span><span>Delete campaign</span></button></div></div></div></div>

@section Scripts { <script src="~/js/stamp-campaigns.js" asp-append-version="true"></script> }
