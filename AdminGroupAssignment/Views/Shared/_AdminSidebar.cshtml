    string username = Context.Session.GetString("AdminUsername") ?? "admin";

    // 24x24 stroke icons
    var icons = new Dictionary<string, string>
    {
        ["dashboard"] = "<rect x='3' y='3' width='7' height='9' rx='1.5'/><rect x='14' y='3' width='7' height='5' rx='1.5'/><rect x='14' y='12' width='7' height='9' rx='1.5'/><rect x='3' y='16' width='7' height='5' rx='1.5'/>",
        ["members"] = "<circle cx='9' cy='8' r='3.5'/><path d='M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6'/><path d='M16 4.6a3.5 3.5 0 0 1 0 6.8'/><path d='M18 14.3c2.1.7 3.5 2.6 3.5 5.7'/>",
        ["merchants"] = "<path d='M4 9l1.5-5h13L20 9'/><path d='M4 9a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0A2.7 2.7 0 0 0 20 9'/><path d='M5 12v8h14v-8'/>",
        ["outlets"] = "<path d='M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z'/><circle cx='12' cy='9.5' r='2.5'/>",
        ["staff"] = "<rect x='3' y='5' width='18' height='14' rx='2'/><circle cx='9' cy='11' r='2'/><path d='M6 16c.5-1.5 1.8-2.2 3-2.2s2.5.7 3 2.2'/><path d='M15 10h3M15 14h3'/>",
        ["menu"] = "<path d='M6 3v8a2 2 0 0 0 2 2v8'/><path d='M10 3v8'/><path d='M6 7h4'/><path d='M17 3c-2 1.5-3 4-3 7h3v11'/>",
        ["orders"] = "<path d='M5 8h14l-1 12H6L5 8z'/><path d='M9 8a3 3 0 0 1 6 0'/>",
        ["feedback"] = "<path d='M4 5h16v11H9l-5 4V5z'/>",
        ["rewards"] = "<rect x='3' y='8' width='18' height='4' rx='1'/><path d='M5 12v8h14v-8'/><path d='M12 8v12'/><path d='M12 8c-2.5 0-4-1-4-2.5S9.5 3 12 8zM12 8c2.5 0 4-1 4-2.5S14.5 3 12 8z'/>",
        ["vouchers"] = "<path d='M3 9a2 2 0 0 0 0 6v3h18v-3a2 2 0 0 1 0-6V6H3v3z'/><path d='M14 6v12' stroke-dasharray='2 2'/>",
        ["stamp"] = "<circle cx='12' cy='6.5' r='3'/><path d='M12 9.5V13'/><path d='M8 13h8l1 5H7l1-5z'/><path d='M5 21h14'/>",
        ["banners"] = "<rect x='3' y='4' width='18' height='16' rx='2'/><circle cx='9' cy='10' r='1.6'/><path d='M21 16l-5-5-8 8'/>",
        ["transactions"] = "<rect x='3' y='5' width='18' height='14' rx='2'/><path d='M3 10h18'/><path d='M7 15h4'/>",
        ["notifications"] = "<path d='M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15L6 16z'/><path d='M10 21h4'/>",
        ["versions"] = "<rect x='7' y='2.5' width='10' height='19' rx='2'/><path d='M11 18h2'/>",
        ["shield"] = "<path d='M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z'/><path d='m9 12 2 2 4-4'/>",
        ["import"] = "<path d='M12 16V4'/><path d='M7 9l5-5 5 5'/><path d='M4 16v4h16v-4'/>",
        ["logout"] = "<path d='M9 4H5v16h4'/><path d='M16 8l4 4-4 4'/><path d='M20 12H9'/>"
    };

    // Group title (null = no title), then items: label, action, icon
    var groups = new List<(string? Title, (string Label, string Action, string Icon)[] Items)>
    {
        (null, new[] { ("Dashboard", "Dashboard", "dashboard") }),
        ("People", new[]
        {
            ("Members", "Members", "members"),
            ("Merchants", "Merchants", "merchants"),
            ("Outlets", "Outlets", "outlets"),
            ("Staff", "Staff", "staff")
        }),
        ("Sales", new[]
        {
            ("Menu", "Menu", "menu"),
            ("Orders", "Orders", "orders"),
            ("Feedback", "Feedback", "feedback")
        }),
        ("Loyalty", new[]
        {
            ("Rewards", "Rewards", "rewards"),
            ("Vouchers", "Vouchers", "vouchers"),
            ("Stamp campaigns", "StampCampaigns", "stamp"),
            ("Banners", "Banners", "banners")
        }),
        ("Money and messages", new[]
        {
            ("Transactions", "Transactions", "transactions"),
            ("Notifications", "Notifications", "notifications")
        }),
        ("System", new[]
        {
            ("API Authorization", "ApiAuthorization", "shield"),
            ("App versions", "AppVersions", "versions"),
            ("Data import", "DataImport", "import")
        })
    };
}

<aside class="sidebar" id="sidebar" aria-label="Admin navigation">

    <a class="brand" href="@Url.Action("Dashboard", "Admin")">
        <span class="brand-mark">A</span>
        <span class="brand-name">Admin Portal</span>
    </a>

    <nav class="side-nav">
        @foreach (var group in groups)
        {
            <div class="nav-group">
                @if (!string.IsNullOrEmpty(group.Title))
                {
                    <div class="nav-title">@group.Title</div>
                }

                @foreach (var item in group.Items)
                {
                    bool active = string.Equals(item.Action, current, StringComparison.OrdinalIgnoreCase);

                    <a class="nav-link @(active ? "active" : "")"
                       href="@Url.Action(item.Action, "Admin")"
                       aria-current="@(active ? "page" : null)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            @Html.Raw(icons[item.Icon])
                        </svg>
                        <span>@item.Label</span>
                    </a>
                }
            </div>
        }
    </nav>

    <div class="side-user">
        <span class="avatar" aria-hidden="true">@username.Substring(0, 1).ToUpper()</span>
        <div class="user-text">
            <strong>@username</strong>
            <span>Administrator</span>
        </div>
        <a class="logout" href="@Url.Action("Logout", "Admin")" title="Sign out" aria-label="Sign out">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                @Html.Raw(icons["logout"])
            </svg>
        </a>
    </div>

</aside>
