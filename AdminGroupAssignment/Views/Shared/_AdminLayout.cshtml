<!DOCTYPE html>
<html lang="en">
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<head>

    <meta charset="utf-8" />
    <meta name="admin-request-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - EduvoShop
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Admin Global CSS -->
    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    <!-- Page Specific CSS -->
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/portal-polish.css" asp-append-version="true" />

</head>

<body>

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var adminName = Context.Session.GetString("AdminUsername") ?? "Admin";
        var adminInitial = adminName.Length > 0 ? adminName.Substring(0, 1).ToUpperInvariant() : "A";
        var merchantGroupActive = currentAction == "Merchants" || currentAction == "MerchantList" || currentAction == "Outlets" || currentAction == "Staff";
    }

    <div class="admin-layout">

        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar" id="adminSidebar" aria-label="Admin navigation">
            <a class="brand" asp-controller="Admin" asp-action="Dashboard">
                <span class="brand-mark"><i class="bi bi-bag-heart-fill"></i></span>
                <span class="brand-copy"><strong>EduvoShop</strong><small>Merchant Portal</small></span>
            </a>

            <nav class="sidebar-nav">
                <div class="nav-section">
                    <div class="nav-title">Overview</div>
                    <a asp-controller="Admin" asp-action="Dashboard" class="nav-link @(currentAction == "Dashboard" ? "active" : "")"><span class="nav-icon"><i class="bi bi-grid-1x2"></i></span><span>Dashboard</span></a>
                </div>
                <div class="nav-section">
                    <div class="nav-title">Management</div>
                    <div class="sidebar-nav-group @(merchantGroupActive ? "open" : "")">
                        <button type="button" class="nav-link sidebar-group-toggle @(merchantGroupActive ? "active" : "")" aria-expanded="@(merchantGroupActive ? "true" : "false")" aria-controls="merchantSubmenu">
                            <span class="nav-icon"><i class="bi bi-shop"></i></span><span>Merchant</span><i class="bi bi-chevron-down sidebar-chevron"></i>
                        </button>
                        <div class="sidebar-submenu" id="merchantSubmenu">
                            <a asp-controller="Admin" asp-action="MerchantList" class="sidebar-sub-link @(currentAction == "MerchantList" || currentAction == "Merchants" ? "active" : "")"><i class="bi bi-building"></i><span>Merchants</span></a>
                            <a asp-controller="Admin" asp-action="Outlets" class="sidebar-sub-link @(currentAction == "Outlets" ? "active" : "")"><i class="bi bi-geo-alt"></i><span>Outlets</span></a>
                            <a asp-controller="Admin" asp-action="Staff" class="sidebar-sub-link @(currentAction == "Staff" ? "active" : "")"><i class="bi bi-person-badge"></i><span>Staff</span></a>
                        </div>
                    </div>
                    <a asp-controller="Admin" asp-action="Menu" class="nav-link @(currentAction == "Menu" ? "active" : "")"><span class="nav-icon"><i class="bi bi-menu-button-wide"></i></span><span>Menu</span></a>
                    <a asp-controller="Admin" asp-action="Members" class="nav-link @(currentAction == "Members" ? "active" : "")"><span class="nav-icon"><i class="bi bi-people"></i></span><span>Members</span></a>
                    <a asp-controller="Admin" asp-action="Feedback" class="nav-link @(currentAction == "Feedback" ? "active" : "")"><span class="nav-icon"><i class="bi bi-chat-square-text"></i></span><span>Feedback</span></a>
                </div>
                <div class="nav-section">
                    <div class="nav-title">Promotions</div>
                    <a asp-controller="Admin" asp-action="Rewards" class="nav-link @(currentAction == "Rewards" ? "active" : "")"><span class="nav-icon"><i class="bi bi-gift"></i></span><span>Rewards</span></a>
                    <a asp-controller="Admin" asp-action="Vouchers" class="nav-link @(currentAction == "Vouchers" ? "active" : "")"><span class="nav-icon"><i class="bi bi-ticket-perforated"></i></span><span>Vouchers</span></a>
                    <a asp-controller="Admin" asp-action="StampCampaigns" class="nav-link @(currentAction == "StampCampaigns" ? "active" : "")"><span class="nav-icon"><i class="bi bi-postage"></i></span><span>Stamp campaigns</span></a>
                    <a asp-controller="Admin" asp-action="Banners" class="nav-link @(currentAction == "Banners" ? "active" : "")"><span class="nav-icon"><i class="bi bi-images"></i></span><span>Banners</span></a>
                </div>
                <div class="nav-section">
                    <div class="nav-title">Activity</div>
                    <a asp-controller="Admin" asp-action="Transactions" class="nav-link @(currentAction == "Transactions" ? "active" : "")"><span class="nav-icon"><i class="bi bi-receipt"></i></span><span>Transactions</span></a>
                    <a asp-controller="Admin" asp-action="Orders" class="nav-link @(currentAction == "Orders" ? "active" : "")"><span class="nav-icon"><i class="bi bi-bag-check"></i></span><span>Orders</span></a>
                </div>
                <div class="nav-section">
                    <div class="nav-title">System</div>
                    <a asp-controller="Admin" asp-action="Notifications" class="nav-link @(currentAction == "Notifications" ? "active" : "")"><span class="nav-icon"><i class="bi bi-bell"></i></span><span>Notifications</span></a>
                    <a asp-controller="Admin" asp-action="AppVersions" class="nav-link @(currentAction == "AppVersions" ? "active" : "")"><span class="nav-icon"><i class="bi bi-phone"></i></span><span>App version</span></a>
                    <a asp-controller="Admin" asp-action="DataImport" class="nav-link @(currentAction == "DataImport" ? "active" : "")"><span class="nav-icon"><i class="bi bi-file-earmark-arrow-up"></i></span><span>Data import</span></a>
                </div>
            </nav>

            <div class="sidebar-bottom">
                <div class="sidebar-profile"><span class="profile-avatar">@adminInitial</span><span class="profile-copy"><strong>@adminName</strong><small>Administrator</small></span></div>
                <form asp-controller="Admin" asp-action="Logout" method="post" class="logout-form">
                    <button type="submit" class="logout-link" title="Sign out" aria-label="Sign out"><i class="bi bi-box-arrow-right"></i><span>Logout</span></button>
                </form>
            </div>
        </aside>
        <button type="button" class="sidebar-scrim" id="scrim" aria-label="Close navigation"></button>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <main class="main-content">


            <!-- ================= TOP BAR ================= -->

            <header class="topbar">

                <button type="button" class="mobile-menu" id="menuBtn" aria-label="Open navigation" aria-controls="adminSidebar" aria-expanded="false"><i class="bi bi-list"></i></button>

                <div class="page-heading">

                    <h1>
                        @ViewData["Title"]
                    </h1>


                    @if (ViewData["Subtitle"] != null)
                    {
                        <p>
                            @ViewData["Subtitle"]
                        </p>
                    }

                </div>


                <!-- ================= HEADER ACTIONS ================= -->

                <div class="header-actions">

                    @RenderSection("HeaderActions", required: false)

                </div>

            </header>


            <!-- ================= PAGE CONTENT ================= -->

            <div class="page-content">

                @RenderBody()

            </div>

        </main>

    </div>


    <!-- =====================================================
         BOOTSTRAP JS
    ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/admin-request-security.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/admin-list-sort.js" asp-append-version="true"></script>


    <!-- =====================================================
         PAGE SPECIFIC JAVASCRIPT
    ====================================================== -->
    @RenderSection("Scripts", required: false)

</body>

</html>
